<?xml version="1.0" encoding="utf-8"?><!--
   Data-extraction rules for API 31 and above (android:dataExtractionRules).
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes

   Same reasoning as backup_rules.xml, for both transports: cloud backup and device-to-device
   transfer. A bank is a running clock rather than a setting — it says how much time is left
   and which day it belongs to — so a copy that lands on another device at another time
   hands out minutes nobody won.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
