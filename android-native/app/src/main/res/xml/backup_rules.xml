<?xml version="1.0" encoding="utf-8"?><!--
   Full-backup rules for API 30 and below (android:fullBackupContent).
   See https://developer.android.com/guide/topics/data/autobackup

   The enforcement database is deliberately not backed up. It is not a record of what the
   user configured so much as the state of a running clock: the banks, the day each belongs
   to and the moment each was last billed, all keyed on absolute epoch millis. Restored
   onto a different device at a different moment, a bank is time nobody won, and the list
   of targets it belongs to is a decision the user is supposed to make again on the new
   device. SQLite backup works at file granularity, so excluding the database takes the
   targets list with it — the price of not restoring minutes onto a phone that never
   earned them.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <!-- The onboarding flag is device state too: a restored copy skips setup on a device
         that has never granted the accessibility permission. -->
    <exclude domain="file" path="datastore/" />
</full-backup-content>
